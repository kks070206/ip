<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="jason.gui.MainWindow">
    <children>
        <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Enter a command"
                   AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="76.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" text="Send"
                AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0"
                    AnchorPane.bottomAnchor="43.0" AnchorPane.leftAnchor="1.0"
                    AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="1.0">
            <content>
                <VBox fx:id="dialogContainer" prefWidth="488.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
